{
  "name": "dsh-web-search-zai",
  "description": "Z.ai and Zhipu web search for DeepSeek Harness, with Coding Plan MCP quota, REST API billing, and bilingual settings.",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib/*.js",
    "lib/*.js.map",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Kenny",
    "url": "https://github.com/kenny2077"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenny2077/dsh-web-search-zai.git"
  },
  "homepage": "https://github.com/kenny2077/dsh-web-search-zai#readme",
  "bugs": {
    "url": "https://github.com/kenny2077/dsh-web-search-zai/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "zai",
    "zhipu",
    "glm",
    "web-search",
    "search-provider"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc --build && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/zai.spec.ts tests/mcp.spec.ts tests/client-card.spec.tsx",
    "prepublishOnly": "pnpm build",
    "test:live": "vitest run tests/zai.e2e.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-invariants": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cosmokit": "^1.8.2",
    "@deepseek-ai/dsh-credentials": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-web": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "react": "^19.2.8",
    "react-test-renderer": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
